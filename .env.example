# OKX AI Quant Lab - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Demo trading mode (default: true)
LIVE_TRADING_ENABLED=false

# Risk policy to use
RISK_POLICY=config/risk_policy.demo.yaml

# OKX CLI profile (default: demo)
OKX_PROFILE=demo

# Data settings
DEFAULT_INST_IDS=BTC-USDT,ETH-USDT,SOL-USDT
DEFAULT_BARS=1H,4H,1D

# Third-party API keys (read-only data — never commit real values here)
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
COINMARKETCAP_API_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
COINGLASS_API_KEY=
MORALIS_API_KEY=
ARKHAM_API_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_ENABLED=false
FEISHU_PUSH_MODE=cli
