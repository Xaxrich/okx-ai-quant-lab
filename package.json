    "strategy-admission": "tsx src/research/run_admission.ts",
    "demo:propose": "tsx src/execution/dry_run.ts",
    "demo:preflight": "tsx src/execution/demo_preflight.ts",
    "demo:roundtrip": "tsx src/execution/demo_roundtrip.ts",
    "demo:runner": "tsx src/runner/demo_strategy_runner.ts",
