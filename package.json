    "scanner:mvp": "tsx src/altcoin/scanner_mvp/scanner_mvp.ts",
    "scanner:mvp-v2": "tsx src/altcoin/scanner_mvp/scanner_mvp_v2.ts",
    "scanner:fetch-integrated": "tsx src/altcoin/scanner_mvp/integrated_data_fetcher.ts",
